<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".HomeActivity">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/textView8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="64dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/pedidos"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="30sp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.506"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria1"
                            android:layout_width="178dp"
                            android:layout_height="93dp"
                            android:layout_marginTop="148dp"
                            android:src="@drawable/inicio_tuspedidos_categoria1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.069"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria2"
                            android:layout_width="178dp"
                            android:layout_height="93dp"
                            android:layout_marginTop="148dp"
                            android:src="@drawable/inicio_tuspedidos_categoria2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.513"
                            app:layout_constraintStart_toEndOf="@+id/categoria1"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria3"
                            android:layout_width="178dp"
                            android:layout_height="94dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="264dp"
                            android:src="@drawable/inicio_tuspedidos_categoria3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria4"
                            android:layout_width="178dp"
                            android:layout_height="94dp"
                            android:layout_marginTop="264dp"
                            android:src="@drawable/inicio_tuspedidos_categoria4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.567"
                            app:layout_constraintStart_toEndOf="@+id/categoria3"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imageView14"
                            android:layout_width="507dp"
                            android:layout_height="448dp"
                            android:layout_marginTop="360dp"
                            android:src="@drawable/inicio_fondocalendario"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="360dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/calendario"
                            android:textColor="@color/white"
                            android:textSize="40sp"
                            app:layout_constraintBottom_toBottomOf="@+id/imageView14"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.463"
                            app:layout_constraintStart_toStartOf="parent" />

                        <com.kizitonwose.calendarview.CalendarView
                            android:id="@+id/calendarMini"
                            android:layout_width="412dp"
                            android:layout_height="223dp"
                            android:layout_marginTop="372dp"
                            android:contentDescription="Calendario de pedidos"
                            app:cv_dayViewResource="@layout/calendar_day"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.666"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView8" />

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="36dp"
                            android:text="@string/categoria1"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria1"
                            app:layout_constraintEnd_toEndOf="@+id/categoria1"
                            app:layout_constraintHorizontal_bias="0.1"
                            app:layout_constraintStart_toStartOf="@+id/categoria1"
                            app:layout_constraintTop_toTopOf="@+id/categoria1"
                            app:layout_constraintVertical_bias="0.789" />

                        <TextView
                            android:id="@+id/textView9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/categoria2"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria2"
                            app:layout_constraintEnd_toEndOf="@+id/categoria2"
                            app:layout_constraintHorizontal_bias="0.141"
                            app:layout_constraintStart_toStartOf="@+id/categoria2"
                            app:layout_constraintTop_toTopOf="@+id/categoria2"
                            app:layout_constraintVertical_bias="0.405" />

                        <TextView
                            android:id="@+id/textView10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/categoria3"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria3"
                            app:layout_constraintEnd_toEndOf="@+id/categoria3"
                            app:layout_constraintHorizontal_bias="0.1"
                            app:layout_constraintStart_toStartOf="@+id/categoria3"
                            app:layout_constraintTop_toTopOf="@+id/categoria3"
                            app:layout_constraintVertical_bias="0.373" />

                        <TextView
                            android:id="@+id/textView11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/categoria4"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria4"
                            app:layout_constraintEnd_toEndOf="@+id/categoria4"
                            app:layout_constraintHorizontal_bias="0.116"
                            app:layout_constraintStart_toStartOf="@+id/categoria4"
                            app:layout_constraintTop_toTopOf="@+id/categoria4"
                            app:layout_constraintVertical_bias="0.373" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#67b0a1"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/white"
        app:itemTextAppearance="@style/drawerTextAppearance"
        app:itemTextColor="@color/white"
        app:menu="@menu/nav_options" />

</androidx.drawerlayout.widget.DrawerLayout>

