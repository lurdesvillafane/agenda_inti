<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".HomeActivity">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <!-- TÍTULO PRINCIPAL -->
                        <TextView
                            android:id="@+id/textView8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/pedidos"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="28sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- CATEGORÍA 1 -->
                        <ImageView
                            android:id="@+id/categoria1"
                            android:layout_width="178dp"
                            android:layout_height="93dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="24dp"
                            android:src="@drawable/inicio_tuspedidos_categoria1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/textView8" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria1"
                            app:layout_constraintEnd_toEndOf="@+id/categoria1"
                            app:layout_constraintStart_toStartOf="@+id/categoria1"
                            app:layout_constraintTop_toTopOf="@+id/categoria1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Categoría 1"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textView6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Tiene 0 pedidos pendientes"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- CATEGORÍA 2 -->
                        <ImageView
                            android:id="@+id/categoria2"
                            android:layout_width="178dp"
                            android:layout_height="93dp"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/inicio_tuspedidos_categoria2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/categoria1" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria2"
                            app:layout_constraintEnd_toEndOf="@+id/categoria2"
                            app:layout_constraintStart_toStartOf="@+id/categoria2"
                            app:layout_constraintTop_toTopOf="@+id/categoria2">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Categoría 2"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textView9"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Tiene 0 pedidos pendientes"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- CATEGORÍA 3 -->
                        <ImageView
                            android:id="@+id/categoria3"
                            android:layout_width="178dp"
                            android:layout_height="94dp"
                            android:layout_marginTop="16dp"
                            android:src="@drawable/inicio_tuspedidos_categoria3"
                            app:layout_constraintStart_toStartOf="@+id/categoria1"
                            app:layout_constraintTop_toBottomOf="@+id/categoria1" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria3"
                            app:layout_constraintEnd_toEndOf="@+id/categoria3"
                            app:layout_constraintStart_toStartOf="@+id/categoria3"
                            app:layout_constraintTop_toTopOf="@+id/categoria3">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Categoría 3"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textView10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Tiene 0 pedidos pendientes"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- CATEGORÍA 4 -->
                        <ImageView
                            android:id="@+id/categoria4"
                            android:layout_width="178dp"
                            android:layout_height="94dp"
                            android:src="@drawable/inicio_tuspedidos_categoria4"
                            app:layout_constraintEnd_toEndOf="@+id/categoria2"
                            app:layout_constraintTop_toTopOf="@+id/categoria3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria4"
                            app:layout_constraintEnd_toEndOf="@+id/categoria4"
                            app:layout_constraintStart_toStartOf="@+id/categoria4"
                            app:layout_constraintTop_toTopOf="@+id/categoria4">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:text="Categoría 4"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/textView11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Tiene 0 pedidos pendientes"
                                android:textColor="@color/white"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- FONDO DEL CALENDARIO -->
                        <ImageView
                            android:id="@+id/imageView14"
                            android:layout_width="0dp"
                            android:layout_height="420dp"
                            android:layout_marginTop="24dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/inicio_fondocalendario"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/categoria3" />

                        <!-- TÍTULO CALENDARIO -->
                        <TextView
                            android:id="@+id/textView5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/calendario"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            app:layout_constraintEnd_toEndOf="@+id/imageView14"
                            app:layout_constraintStart_toStartOf="@+id/imageView14"
                            app:layout_constraintTop_toTopOf="@+id/imageView14" />

                        <!-- CALENDARIO -->
                        <CalendarView
                            android:id="@+id/CalendarView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="24dp"
                            app:layout_constraintEnd_toEndOf="@+id/imageView14"
                            app:layout_constraintStart_toStartOf="@+id/imageView14"
                            app:layout_constraintTop_toBottomOf="@+id/textView5" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#67b0a1"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/white"
        app:itemTextAppearance="@style/drawerTextAppearance"
        app:itemTextColor="@color/white"
        app:menu="@menu/nav_options" />

</androidx.drawerlayout.widget.DrawerLayout>