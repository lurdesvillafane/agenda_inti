<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".PedidosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="1000dp">

                        <TextView
                            android:id="@+id/textView8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="68dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="TUS PEDIDOS"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="30sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.497"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria1"
                            android:layout_width="507dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="168dp"
                            android:src="@drawable/pedidos_categoria1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria2"
                            android:layout_width="507dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="280dp"
                            android:src="@drawable/pedidos_categoria2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria3"
                            android:layout_width="507dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="392dp"
                            android:src="@drawable/pedidos_categoria3"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria4"
                            android:layout_width="507dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="508dp"
                            android:src="@drawable/pedidos_categoria4"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/categoria5"
                            android:layout_width="507dp"
                            android:layout_height="200dp"
                            android:layout_marginTop="596dp"
                            android:src="@drawable/pedidos_categoria5"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textView6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/categoria1"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria1"
                            app:layout_constraintEnd_toEndOf="@+id/categoria1"
                            app:layout_constraintHorizontal_bias="0.238"
                            app:layout_constraintStart_toStartOf="@+id/categoria1"
                            app:layout_constraintTop_toTopOf="@+id/categoria1"
                            app:layout_constraintVertical_bias="0.3" />

                        <TextView
                            android:id="@+id/textView9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/categoria2"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria2"
                            app:layout_constraintEnd_toEndOf="@+id/categoria2"
                            app:layout_constraintHorizontal_bias="0.238"
                            app:layout_constraintStart_toStartOf="@+id/categoria2"
                            app:layout_constraintTop_toTopOf="@+id/categoria2"
                            app:layout_constraintVertical_bias="0.25" />

                        <TextView
                            android:id="@+id/textView10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/categoria3"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria3"
                            app:layout_constraintEnd_toEndOf="@+id/categoria3"
                            app:layout_constraintHorizontal_bias="0.238"
                            app:layout_constraintStart_toStartOf="@+id/categoria3"
                            app:layout_constraintTop_toTopOf="@+id/categoria3"
                            app:layout_constraintVertical_bias="0.244" />

                        <TextView
                            android:id="@+id/textView11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/categoria4"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria4"
                            app:layout_constraintEnd_toEndOf="@+id/categoria4"
                            app:layout_constraintHorizontal_bias="0.236"
                            app:layout_constraintStart_toStartOf="@+id/categoria4"
                            app:layout_constraintTop_toTopOf="@+id/categoria4"
                            app:layout_constraintVertical_bias="0.255" />

                        <TextView
                            android:id="@+id/textView12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text="@string/categoria4"
                            android:textColor="@color/white"
                            app:layout_constraintBottom_toBottomOf="@+id/categoria5"
                            app:layout_constraintEnd_toEndOf="@+id/categoria5"
                            app:layout_constraintHorizontal_bias="0.236"
                            app:layout_constraintStart_toStartOf="@+id/categoria5"
                            app:layout_constraintTop_toTopOf="@+id/categoria5"
                            app:layout_constraintVertical_bias="0.255" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="184dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#67b0a1"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/white"
        app:itemTextAppearance="@style/drawerTextAppearance"
        app:itemTextColor="@color/white"
        app:menu="@menu/nav_options" />

</androidx.drawerlayout.widget.DrawerLayout>